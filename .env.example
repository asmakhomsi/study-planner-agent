# Copy this file to .env and fill in your own keys. Never commit .env (it is in .gitignore).
# Which model run.py --llm real uses: a, b, c or d (see LLMS in planner/llm.py).
LLM=a

# a, d: OpenRouter (nvidia/nemotron-3-ultra-550b-a55b:free, cohere/north-mini-code:free)
OPENROUTER_KEY=
# b: Google AI Studio (gemini-3.5-flash-lite)
GEMINI_KEY=
# c: Groq (openai/gpt-oss-120b), smoke test only
GROQ_KEY=
# Not used any more: DeepSeek returned 402 (no balance) in the smoke test
DEEPSEEK_KEY=
